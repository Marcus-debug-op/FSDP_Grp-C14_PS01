# Copy this file to .env and fill in your own values. Never commit .env.

# Database (Neon connection string for the branch you are using)
DATABASE_URL=

# Login tokens: any long random string. The server will not start without it.
JWT_SECRET=

# Server
PORT=3000
# The website address allowed to call this API (no slash at the end)
FRONTEND_URL=http://localhost:5173
# Optional, phone/Wi-Fi testing only. Comma-separated. Leave empty normally.
EXTRA_CORS_ORIGINS=

# Stripe (use TEST keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional locally; required in production or emails stay "pending")
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Testing switches: keep false (or remove) in production
CHECKIN_TEST_MODE=false
GRADING_TEST_MODE=false

# Only for "npm run seed" (creates the first admin / instructor accounts)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_INSTRUCTOR_NAME=
SEED_INSTRUCTOR_EMAIL=
SEED_INSTRUCTOR_PASSWORD=
